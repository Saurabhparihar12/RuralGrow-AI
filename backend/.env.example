# RuralGrow AI Backend Environment Configuration Template
PORT=5000
NODE_ENV=production

# Frontend Client URL allowed for production CORS and OAuth redirects
CLIENT_URL=https://ruralgrowai.vercel.app

# Database Configuration (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ruralgrow?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secure_production_jwt_secret_key

# Google Gemini AI Key (Powered by gemini-1.5-flash)
GEMINI_API_KEY=your_google_gemini_api_key

# Google OAuth Credentials (Optional - for live Google OAuth sign in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://ruralgrowai-api.onrender.com/api/auth/google/callback
